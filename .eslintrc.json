{
  "env": { "browser": true, "node": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022 },
  "rules": {
    "no-unused-vars": ["warn", { "vars": "all", "args": "none" }],
    "no-undef": "error",
    "no-eval": "error",
    "no-implied-eval": "error"
  },
  "ignorePatterns": ["tests/fixtures/**"]
}
